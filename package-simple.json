{
  "name": "cs-visionaries-book",
  "version": "1.0.0",
  "description": "コンピュータサイエンスを築いた人物と技術潮流の物語 - 計算理論、ソフトウェア基盤、インターネット、AIまで、現代のデジタル社会を形作った発想と意思決定をたどる。",
  "author": "ITDO Inc. (株式会社アイティードゥ)",
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "setup": "node easy-setup.js",
    "build": "node scripts/build-simple.js",
    "build:full": "node scripts/build.js",
    "preview": "npm run build && npx http-server docs -p 8080 --silent",
    "clean": "rm -rf docs output temp",
    "lint:light": "markdownlint 'src/**/*.md' --ignore node_modules",
    "test:light": "npm run lint:light && npm run build",
    "help": "echo 'Available commands:\n  npm run build - Build the book\n  npm run preview - Local preview (docs/)'",
    "check:metadata": "node scripts/check-metadata-consistency.js"
  },
  "dependencies": {
    "fs-extra": "^11.1.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "markdownlint-cli": "^0.33.0"
  },
  "optionalDependencies": {
    "sharp": "^0.34.2",
    "puppeteer": "^21.0.0"
  },
  "keywords": [
    "book",
    "computer-science",
    "history",
    "technology-trends",
    "github-pages",
    "digital-transformation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itdojp/cs-visionaries-book.git"
  },
  "bugs": {
    "url": "https://github.com/itdojp/cs-visionaries-book/issues"
  },
  "homepage": "https://itdojp.github.io/cs-visionaries-book/"
}
